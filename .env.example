# Example production values. Do not commit a real .env file or set these to placeholders in a live service.
NODE_ENV=production
PORT=3001
DATA_DIR=/data
PUBLIC_ORIGIN=https://your-app.example
COOKIE_SECURE=1
# No database password: SQLite lives on a private, durable volume at DATA_DIR.
# Never put DATA_DIR or backup files under dist/ or a publicly served directory.
