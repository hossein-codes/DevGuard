# Single-instance persistent Node service. Mount DATA_DIR on a private durable volume.
DATA_DIR=./data
PORT=3001
# Optional exact public origin for cookie CSRF origin checks behind a trusted TLS proxy.
# In local development the request Host is used; set this in production.
PUBLIC_ORIGIN=https://your-app.example
# Set to 1 only behind a trusted HTTPS terminator; sets the Secure cookie attribute.
COOKIE_SECURE=1
